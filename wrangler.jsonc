// Serveur multijoueur sur Cloudflare Workers + Durable Objects (plan gratuit). Déployer : npm run deploy:cf
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snaike",
  "main": "cf/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "PUBLIC_URL": "https://playsnaike.vercel.app" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomObject" },
      { "name": "SPONSORS", "class_name": "SponsorsObject" }
    ]
  },
  // Le plan gratuit n'accepte que les Durable Objects adossés à SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject", "SponsorsObject"] }],
  "observability": { "enabled": true }
}
